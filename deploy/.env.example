# =============================================================================
# Aictiq - docker compose environment
# =============================================================================
# cp .env.example .env, then fill in every CHANGE_ME below. Compose refuses to
# start rather than fall back to a default for anything that is a secret.
#
# Generate secrets:
#   openssl rand -base64 48        # JWT_KEY, POSTGRES_*_PASSWORD, SEED_ADMIN_PASSWORD
#   openssl rand -hex 32           # GARAGE_RPC_SECRET, S3_SECRET_KEY (64 hex chars)
#   printf 'GK%s\n' "$(openssl rand -hex 12)"   # S3_ACCESS_KEY (Garage's required shape)
# =============================================================================


# ---------------------------------------------------------------- where it lives
# http://localhost      local evaluation, plain HTTP, no certificate
# https://your.domain   Caddy obtains and renews a certificate automatically.
#                       Point the domain's A/AAAA record at this host first.
AICTIQ_URL=http://localhost
# Semicolon-separated host names only (no scheme or port). Include the public hostname.
AICTIQ_ALLOWED_HOSTS=localhost

# Only change these if 80/443 are taken. A non-default port must ALSO appear in
# AICTIQ_URL above (e.g. AICTIQ_URL=http://localhost:8080 with HTTP_PORT=8080): Caddy
# listens on the port the site address names, and the container publishes the same one.
HTTP_PORT=80
HTTPS_PORT=443


# ---------------------------------------------------------------- secrets
# JWT signing key. Minimum 32 characters, enforced at startup. Changing it signs
# every existing session out.
JWT_KEY=CHANGE_ME_openssl_rand_base64_48

# The owner login is only for startup migrations. The API and workers use the separate,
# RLS-constrained app login; do not reuse these two passwords.
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_openssl_rand_base64_48
POSTGRES_APP_PASSWORD=CHANGE_ME_openssl_rand_base64_48


# ---------------------------------------------------------------- object storage
# Garage's internal cluster secret and admin token. Not reachable from outside the
# compose network, but they are still secrets.
GARAGE_RPC_SECRET=CHANGE_ME_openssl_rand_hex_32
GARAGE_ADMIN_TOKEN=CHANGE_ME_openssl_rand_hex_32

# S3 credentials. Garage requires the access key to be "GK" followed by exactly 24
# hex characters, and the secret to be 64 hex characters - anything else is refused
# when the key is imported.
S3_ACCESS_KEY=CHANGE_ME_GK_plus_24_hex_chars
S3_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
S3_BUCKET=aictiq

# How much space Garage advertises for this node, in bytes. It is a declaration, not
# a reservation; make sure the volume can actually hold it. Default 100 GiB.
GARAGE_CAPACITY_BYTES=107374182400


# ---------------------------------------------------------------- first run
# The administrator created the first time the API starts against an empty database.
# Change the password after signing in; it stays in this file otherwise.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME_at_least_12_characters

# The organization that administrator owns, created alongside them. Leave the name blank
# to start with none and create one from the app instead. Only ever applied to an empty
# installation: once any organization exists these are ignored, so deleting the seeded
# one does not bring it back on the next restart.
SEED_ORG_NAME=Example Company
# Its address - the {slug} in /orgs/{slug}. Derived from the name when blank. Permanent:
# renaming the organization later does not change it.
SEED_ORG_SLUG=
# IANA identifier. Decides when "today" ends for due dates and sprint boundaries.
SEED_ORG_TIME_ZONE=UTC

# Set false to make this an invitation-only instance. People who are not already members
# see the invite request screen instead of being able to create a separate organization.
ORG_ALLOW_SELF_SERVE_CREATION=true


# ---------------------------------------------------------------- images
# Compose builds the API and workers from this checkout by default, so a fresh clone can
# start without registry credentials. To use published images instead, set
# AICTIQ_IMAGE_PULL_POLICY=always plus the registry and tag below.
AICTIQ_IMAGE_PULL_POLICY=build
AICTIQ_IMAGE_REGISTRY=aictiq-local
AICTIQ_IMAGE_TAG=local

# ---------------------------------------------------------------- release updates
# Disabled by default. Enabling this makes signed-in browsers query GitHub's public
# release API once per day to display an available newer version in the footer.
RELEASE_UPDATE_CHECK_ENABLED=false
RELEASE_UPDATE_CHECK_REPOSITORY=Green-Code-DEV/aictiq


# ---------------------------------------------------------------- networking
# Caddy needs a fixed address because the API's ReverseProxy__KnownProxies takes exact
# IPs - a proxy whose address changes on every `up` cannot be trusted, and then the
# rate limiter throttles Caddy's single address for every user at once. Change both
# together only if this subnet collides with an existing Docker network.
AICTIQ_SUBNET=10.89.7.0/24
CADDY_IP=10.89.7.10


# ---------------------------------------------------------------- realtime and rate limits
# Postgres is the standard realtime backplane. Redis requires a Redis service reachable
# from the API and its connection string below. Set none to disable browser push updates.
REALTIME_BACKPLANE=postgres
REALTIME_REDIS_CONNECTION_STRING=

# Per-minute limits. Keep the defaults unless your traffic pattern requires a change.
RATE_LIMITING_GLOBAL_PER_MINUTE=300
RATE_LIMITING_AUTH_PER_MINUTE=10
RATE_LIMITING_UPLOADS_PER_MINUTE=20
RATE_LIMITING_SEARCH_PER_MINUTE=120
RATE_LIMITING_MCP_REQUESTS_PER_MINUTE=600
RATE_LIMITING_MCP_TOOLS_PER_MINUTE=60


# ---------------------------------------------------------------- email (optional)
# Leave EMAIL_SMTP_HOST empty and this instance cannot send. That is a supported way to
# run Aictiq: invitations fall back to links you copy out and share yourself, and
# /health/ready answers {"checks":{"email":"unconfigured"}} so you can tell at a glance.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
# STARTTLS when the relay offers it. Only turn this off for a sink on your own machine.
EMAIL_SMTP_STARTTLS=true
# The envelope sender. Required alongside the host - a relay will reject mail without it.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Aictiq

# ---------------------------------------------------------------- anonymous usage telemetry (optional)
# Disabled by default. When enabled, the API posts only its version and aggregate counts
# to the HTTPS endpoint; see docs/telemetry.md before enabling it.
TELEMETRY_ENABLED=false
TELEMETRY_ENDPOINT=


# ---------------------------------------------------------------- optional profiles
# docker compose --profile mailpit up -d
# A local SMTP sink; read captured mail at http://localhost:8025. To point the app at it,
# set EMAIL_SMTP_HOST=mailpit, EMAIL_SMTP_PORT=1025, EMAIL_SMTP_STARTTLS=false and any
# EMAIL_FROM_ADDRESS you like - Mailpit accepts everything and delivers nothing.
MAILPIT_UI_PORT=8025
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_use_a_long_random_password

# ---------------------------------------------------------------- OAuth sign-in (optional)
# Set both halves of a pair to offer that provider on the login page. The redirect URI to
# register with the provider is  ${AICTIQ_URL}/api/v1/auth/external/<provider>/oauth
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
