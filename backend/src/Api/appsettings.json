{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "Jwt": {
    "Issuer": "aictiq-api",
    "Audience": "aictiq-clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "RateLimiting": {
    "GlobalPermitLimitPerMinute": 300,
    "AuthPermitLimitPerMinute": 10,
    "UploadPermitLimitPerMinute": 20,
    "SearchPermitLimitPerMinute": 120,
    "McpPermitLimitPerMinute": 60,
    "McpRequestPermitLimitPerMinute": 600
  },
  "Mcp": {
    "MaxRequestBodyBytes": 1048576
  },
  "Documentation": {
    "Enabled": true,
    "EnableUi": true
  },
  "Release": {
    "UpdateCheck": {
      "Enabled": false,
      "Repository": "Green-Code-DEV/aictiq"
    }
  },
  "Telemetry": {
    "Enabled": false
  },
  "Realtime": {
    "Backplane": "postgres"
  },
  "ReverseProxy": {
    "KnownProxies": []
  }
}
