<p style="margin:0 0 12px 0;">Hi{% if recipientName != blank %} {{ recipientName }}{% endif %},</p>
<p style="margin:0 0 16px 0;">
  <strong>{{ inviterName }}</strong> invited you to join <strong>{{ organizationName }}</strong>
  as {{ roleArticle | default: "a" }} {{ roleName }}.
</p>
<p style="margin:0 0 24px 0;">
  <a href="{{ acceptUrl }}" style="display:inline-block; background:#1c1917; color:#ffffff; text-decoration:none; padding:10px 18px; border-radius:8px; font-size:14px; font-weight:500;">Accept the invitation</a>
</p>
<p style="margin:0 0 8px 0; color:#78716c; font-size:12px;">
  Or paste this into your browser:<br />
  <a href="{{ acceptUrl }}" style="color:#78716c; word-break:break-all;">{{ acceptUrl }}</a>
</p>
{%- if expiresOn != blank %}
<p style="margin:0; color:#78716c; font-size:12px;">The invitation expires on {{ expiresOn }}.</p>
{%- endif %}
