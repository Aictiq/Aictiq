<p style="margin:0 0 12px 0;">Hi{% if recipientName != blank %} {{ recipientName }}{% endif %},</p>
<p style="margin:0 0 16px 0;">
  Thanks for signing up for {{ productName }}. Confirm that this is your email address to
  finish creating your account:
</p>
<p style="margin:0 0 24px 0;">
  <a href="{{ confirmUrl }}" style="display:inline-block; background:#1c1917; color:#ffffff; text-decoration:none; padding:10px 18px; border-radius:8px; font-size:14px; font-weight:500;">Confirm my email</a>
</p>
<p style="margin:0 0 8px 0; color:#78716c; font-size:12px;">
  Or paste this into your browser:<br />
  <a href="{{ confirmUrl }}" style="color:#78716c; word-break:break-all;">{{ confirmUrl }}</a>
</p>
{%- if expiresOn != blank %}
<p style="margin:0 0 8px 0; color:#78716c; font-size:12px;">The link stops working on {{ expiresOn }}. You can ask for a new one from the sign-in page.</p>
{%- endif %}
<p style="margin:0; color:#78716c; font-size:12px;">
  If you did not sign up, ignore this message and the account will never be usable.
</p>
