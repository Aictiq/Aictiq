<p style="margin:0 0 12px 0; color:#78716c; font-size:12px; font-weight:600; letter-spacing:0.08em; text-transform:uppercase;">Watched item update</p>
<h1 style="margin:0 0 12px 0; font-size:22px; line-height:1.3; letter-spacing:-0.02em; overflow-wrap:anywhere;">{{ itemKey }} · {{ itemTitle }}</h1>
<p style="margin:0 0 20px 0;"><strong>{{ actorName }}</strong> moved this item to <strong>{{ toState }}</strong>.</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 20px 0; background:#f5f5f4; border:1px solid #e7e5e4; border-radius:8px;">
  <tr><td style="padding:16px;">
    <div style="font-size:12px; color:#78716c; margin-bottom:6px;">Workflow</div>
    <div style="font-weight:600;">{{ fromState }} &rarr; {{ toState }}</div>
    {%- if itemType != blank or itemPriority != blank %}
    <div style="margin-top:10px; color:#57534e;">{{ itemType }}{% if itemPriority != blank %} · Priority: {{ itemPriority }}{% endif %}</div>
    {%- endif %}
  </td></tr>
</table>
{%- if excerpt != blank %}
<p style="margin:0 0 6px 0; font-weight:600;">About this item</p>
<p style="margin:0 0 20px 0; color:#57534e; white-space:pre-wrap; overflow-wrap:anywhere;">{{ excerpt }}</p>
{%- endif %}
{%- if runId != blank %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 20px 0; border:1px solid #e7e5e4; border-radius:8px;">
  <tr><td style="padding:16px;">
    <p style="margin:0 0 8px 0; font-weight:600;">Factory run · {{ runOutcome }}</p>
    {%- if runSummary != blank %}
    <p style="margin:0 0 12px 0; color:#57534e; white-space:pre-wrap; overflow-wrap:anywhere;">{{ runSummary }}</p>
    {%- endif %}
    <p style="margin:0 0 10px 0; color:#78716c; font-size:12px; overflow-wrap:anywhere;">Run {{ runId }}</p>
    {%- if pullRequestUrl != blank %}
    <p style="margin:0 0 8px 0;"><a href="{{ pullRequestUrl }}" style="color:#1c1917; font-weight:600;">Review pull request &rarr;</a></p>
    {%- endif %}
    {%- if runUrl != blank %}
    <p style="margin:0;"><a href="{{ runUrl }}" style="color:#57534e;">View run details</a></p>
    {%- endif %}
  </td></tr>
</table>
{%- endif %}
<p style="margin:0;"><a href="{{ notificationUrl }}" style="display:inline-block; background:#1c1917; color:#ffffff; text-decoration:none; padding:10px 18px; border-radius:8px; font-size:14px; font-weight:600;">Open {{ itemKey }}</a></p>
