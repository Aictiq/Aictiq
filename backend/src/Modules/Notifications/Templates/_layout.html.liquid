<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ subject }}</title>
  </head>
  <!-- Table layout and inline styles on purpose: half the mail clients in the world
       still strip <style> blocks and know nothing of flexbox. -->
  <body style="margin:0; padding:0; background:#f5f5f4; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif; color:#1c1917;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f5f5f4; padding:32px 16px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px; background:#ffffff; border:1px solid #e7e5e4; border-radius:12px;">
            <tr>
              <td style="padding:24px 28px 0 28px;">
                {%- if organizationLogoUrl != blank %}
                <img src="{{ organizationLogoUrl }}" alt="{{ organizationName }}" height="28" style="height:28px; display:block; border:0;" />
                {%- else %}
                <div style="font-size:15px; font-weight:600; letter-spacing:-0.01em;">{{ organizationName | default: productName }}</div>
                {%- endif %}
              </td>
            </tr>
            <tr>
              <td style="padding:20px 28px 28px 28px; font-size:14px; line-height:1.6;">
                {{ content }}
              </td>
            </tr>
          </table>

          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;">
            <tr>
              <td style="padding:16px 28px; font-size:12px; line-height:1.5; color:#78716c;">
                {{ productName }}{% if organizationName != blank %} · {{ organizationName }}{% endif %}
                {%- if unsubscribeUrl != blank %}
                <br />
                <a href="{{ unsubscribeUrl }}" style="color:#78716c;">Manage which emails you get</a>
                {%- endif %}
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
