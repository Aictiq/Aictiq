<p style="margin:0 0 12px 0;">Hi{% if recipientName != blank %} {{ recipientName }}{% endif %},</p>
<p style="margin:0 0 16px 0;">
  Someone asked to reset the password for this {{ productName }} account. If that was you,
  choose a new one:
</p>
<p style="margin:0 0 24px 0;">
  <a href="{{ resetUrl }}" style="display:inline-block; background:#1c1917; color:#ffffff; text-decoration:none; padding:10px 18px; border-radius:8px; font-size:14px; font-weight:500;">Choose a new password</a>
</p>
<p style="margin:0 0 8px 0; color:#78716c; font-size:12px;">
  Or paste this into your browser:<br />
  <a href="{{ resetUrl }}" style="color:#78716c; word-break:break-all;">{{ resetUrl }}</a>
</p>
{%- if expiresOn != blank %}
<p style="margin:0 0 8px 0; color:#78716c; font-size:12px;">The link works once, and stops working on {{ expiresOn }}.</p>
{%- endif %}
<p style="margin:0; color:#78716c; font-size:12px;">
  If you did not ask for this, nothing has changed and you can ignore this message.
</p>
