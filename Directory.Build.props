<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- One product version is stamped into every .NET executable. Release CI replaces
         this with the validated version from its vX.Y.Z tag. Every other build (dotnet
         run, the compose source build, main images) takes the release line from
         cli/package.json, which release CI already keeps equal to the tag, so it cannot
         drift behind the releases. Keep the default explicitly pre-release so a
         development image can never identify as a release. -->
    <AictiqPackageJson>$(MSBuildThisFileDirectory)cli/package.json</AictiqPackageJson>
    <AictiqReleaseLine Condition="Exists('$(AictiqPackageJson)')">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(AictiqPackageJson)')), '"version"\s*:\s*"(\d+\.\d+\.\d+)').Groups[1].Value)</AictiqReleaseLine>
    <AictiqReleaseLine Condition="'$(AictiqReleaseLine)' == ''">0.0.0</AictiqReleaseLine>
    <Version>$(AictiqReleaseLine)-dev</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
</Project>
